{
  "name": "lightmind-webview",
  "version": "1.0.0",
  "description": "LightMind 桌面应用，展示 www.lightmind.top",
  "author": "lightmindlab",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lightmind.webview",
    "productName": "LightMind",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    }
  }
}
